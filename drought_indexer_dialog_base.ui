<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>droughtIndexerDialogBase</class>
 <widget class="QDialog" name="droughtIndexerDialogBase">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>540</width>
    <height>560</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>SADI Processor</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <property name="leftMargin">
    <number>10</number>
   </property>
   <property name="topMargin">
    <number>10</number>
   </property>
   <property name="rightMargin">
    <number>10</number>
   </property>
   <property name="bottomMargin">
    <number>10</number>
   </property>

   <!-- Authentication -->
   <item>
    <widget class="QGroupBox" name="grpAuth">
     <property name="title">
      <string>Google Earth Engine Authentication</string>
     </property>
     <layout class="QGridLayout" name="authGrid">
      <item row="0" column="0">
       <widget class="QLabel" name="lblProject">
        <property name="text">
         <string>GCP Project ID:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="leProjectId">
        <property name="placeholderText">
         <string>e.g. my-gee-project-123</string>
        </property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QPushButton" name="btnAuthenticate">
        <property name="text">
         <string>Authenticate</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0" colspan="3">
       <widget class="QLabel" name="lblAuthStatus">
        <property name="text">
         <string>Not authenticated</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Analysis Period -->
   <item>
    <widget class="QGroupBox" name="grpDates">
     <property name="title">
      <string>Analysis Period</string>
     </property>
     <layout class="QHBoxLayout" name="datesLayout">
      <item>
       <widget class="QLabel" name="lblStart">
        <property name="text">
         <string>Start Year:</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="startDate"/>
      </item>
      <item>
       <spacer name="hSpacer1">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>20</width>
          <height>20</height>
         </size>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QLabel" name="lblEnd">
        <property name="text">
         <string>End Year:</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="endDate"/>
      </item>
      <item>
       <spacer name="hSpacer2">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>20</width>
          <height>20</height>
         </size>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QLabel" name="lblSeasonLbl">
        <property name="text">
         <string>Season:</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="season">
        <item>
         <property name="text">
          <string>1 — Jan to Mar</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>2 — Apr to Jun</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>3 — Jul to Sep</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>4 — Oct to Dec</string>
         </property>
        </item>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Area of Interest -->
   <item>
    <widget class="QGroupBox" name="grpAOI">
     <property name="title">
      <string>Area of Interest (AOI)</string>
     </property>
     <layout class="QVBoxLayout" name="aoiLayout">
      <item>
       <widget class="QTabWidget" name="tabAOI">

        <!-- Tab: From TOC Layer -->
        <widget class="QWidget" name="tabLayer">
         <attribute name="title">
          <string>From Layer</string>
         </attribute>
         <layout class="QHBoxLayout" name="layerLayout">
          <item>
           <widget class="QComboBox" name="cbTocLayers">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
              <horstretch>1</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnRefreshLayers">
            <property name="text">
             <string>Refresh</string>
            </property>
            <property name="maximumWidth">
             <number>80</number>
            </property>
           </widget>
          </item>
         </layout>
        </widget>

        <!-- Tab: Enter Extent -->
        <widget class="QWidget" name="tabExtent">
         <attribute name="title">
          <string>Enter Extent</string>
         </attribute>
         <layout class="QFormLayout" name="extentForm">
          <property name="labelAlignment">
           <set>Qt::AlignRight|Qt::AlignVCenter</set>
          </property>
          <item row="0" column="0">
           <widget class="QLabel" name="lblNorth">
            <property name="text">
             <string>North — Ymax (lat):</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="sbNorth">
            <property name="minimum">
             <double>-90.000000000000000</double>
            </property>
            <property name="maximum">
             <double>90.000000000000000</double>
            </property>
            <property name="decimals">
             <number>6</number>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="lblSouth">
            <property name="text">
             <string>South — Ymin (lat):</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="sbSouth">
            <property name="minimum">
             <double>-90.000000000000000</double>
            </property>
            <property name="maximum">
             <double>90.000000000000000</double>
            </property>
            <property name="decimals">
             <number>6</number>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="lblWest">
            <property name="text">
             <string>West — Xmin (lon):</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="sbWest">
            <property name="minimum">
             <double>-180.000000000000000</double>
            </property>
            <property name="maximum">
             <double>180.000000000000000</double>
            </property>
            <property name="decimals">
             <number>6</number>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="lblEast">
            <property name="text">
             <string>East — Xmax (lon):</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QDoubleSpinBox" name="sbEast">
            <property name="minimum">
             <double>-180.000000000000000</double>
            </property>
            <property name="maximum">
             <double>180.000000000000000</double>
            </property>
            <property name="decimals">
             <number>6</number>
            </property>
           </widget>
          </item>
         </layout>
        </widget>

        <!-- Tab: From File -->
        <widget class="QWidget" name="tabFile">
         <attribute name="title">
          <string>From File</string>
         </attribute>
         <layout class="QVBoxLayout" name="fileLayout">
          <item>
           <widget class="QLabel" name="lblFileHint">
            <property name="text">
             <string>Select a GeoJSON or Shapefile (.shp / .geojson):</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QgsFileWidget" name="LegeojsonPath"/>
          </item>
          <item>
           <spacer name="fileSpacer">
            <property name="orientation">
             <enum>Qt::Vertical</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>20</width>
              <height>10</height>
             </size>
            </property>
           </spacer>
          </item>
         </layout>
        </widget>

       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Vertical spacer -->
   <item>
    <spacer name="vSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>10</height>
      </size>
     </property>
    </spacer>
   </item>

   <!-- Status + buttons -->
   <item>
    <widget class="QLabel" name="lblStatus">
     <property name="text">
      <string>Ready</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QProgressBar" name="progressBar">
     <property name="value">
      <number>0</number>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="btnLayout">
     <item>
      <spacer name="btnSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QDialogButtonBox" name="okBtn">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="standardButtons">
        <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
       </property>
      </widget>
     </item>
    </layout>
   </item>

  </layout>
 </widget>
 <customwidgets>
